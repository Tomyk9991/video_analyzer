# HIER (privater PC mit Webcam): nur senden
# Windows am einfachsten nativ (kein Docker-USB-Gefrickel):
#   pip install -r requirements.txt
#   python -m poc.main --mode stream --source 0
# Linux alternativ: docker compose --profile stream up streamer
VIDEO_SOURCE=/dev/video0
# VIDEO_SOURCE=0
STREAM_WIDTH=640
STREAM_FPS=10
STREAM_QUALITY=70

# DORT (HA-Maschine, keine Kamera): Stream-Adresse deines PCs
# (IP im Heimnetz; für unterwegs Tailscale/WireGuard statt Portfreigabe)
STREAM_URL=http://192.168.178.10:8000/stream.mjpg

# Analyse-Tuning (DORT)
CONF_THRES=0.5
# Nur jedes N-te Frame durchs Netz jagen (größter Strom-Hebel!)
DETECT_EVERY_N=5

HTTP_PORT=8000
CSV_LOG=poc_log.csv

# Lampen-ROI: "x,y,w,h" in Prozent, Ziel-Helligkeit (V in HSV 0-255)
ROI=80,5,15,15
LAMP_THRES=150

# Home Assistant: NUR LESEN (für den Graphen), der PoC schreibt nie nach HA.
# Token anlegen unter HA-Profil -> Sicherheit -> Langlebige Zugriffstoken.
# Wird nur auf der Maschine gebraucht, wo tools/plot_watts.py --fetch läuft.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Deine Watt-Entität für den Graphen (Name schickst du mir, sobald es läuft)
HA_WATT_ENTITY=

# Nur für Fallback-Schätzung (wenn kein RAPL). Echte Messung braucht nichts.
TDP_WATTS=15
IDLE_WATTS=3
